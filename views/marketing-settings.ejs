<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Marketing Settings | Fitness Extreme International</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    body { font-family: "Inter", sans-serif; background: #f5f7fc; color: #12162e; }
    .font-display { font-family: "Space Grotesk", sans-serif; }
  </style>
</head>
<body>
  <header class="bg-[#0d1230] text-white">
    <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
      <a href="/admin/dashboard" class="font-display font-semibold hover:text-white/80">Fitness Extreme Varthur · Admin</a>
      <nav class="flex items-center gap-4 text-sm">
        <a href="/admin/dashboard" class="text-white/75 hover:text-white">Leads</a>
        <a href="/admin/logout" class="text-white/75 hover:text-white">Logout</a>
      </nav>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-10">
    <p class="text-xs tracking-widest text-[#4f6fd1] uppercase font-bold mb-1">Marketing</p>
    <h1 class="font-display text-2xl md:text-3xl font-semibold text-[#182253]">Tracking &amp; Lead Settings</h1>
    <p class="mt-2 mb-6 text-sm text-black/60">Enter provider IDs here; marketers do not need to edit website code. Leave a provider field blank to disable its tag.</p>

    <% if (success) { %>
      <div role="status" class="mb-5 rounded-xl border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm text-emerald-800"><%= success %></div>
    <% } %>
    <% if (error) { %>
      <div role="alert" class="mb-5 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></div>
    <% } %>

    <form method="post" action="/admin/marketing-settings" class="space-y-6">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>" />

      <section class="rounded-2xl border border-black/5 bg-white p-5 md:p-7 shadow-sm">
        <h2 class="font-display text-lg font-semibold text-[#182253]">Tracking IDs</h2>
        <p class="mt-1 mb-5 text-sm text-black/55">These IDs are used to load the provider tags on the landing page. Never paste JavaScript code or passwords here.</p>

        <div class="grid gap-5 md:grid-cols-2">
          <label class="block text-sm font-medium">
            Google Tag Manager container ID
            <input name="gtm_container_id" type="text" maxlength="32" pattern="GTM-[A-Za-z0-9]+" placeholder="GTM-ABC1234" value="<%= settings.gtm_container_id || '' %>" class="mt-2 w-full rounded-lg border border-black/15 bg-[#f5f7fc] px-4 py-3 font-mono text-sm outline-none focus:border-[#4f6fd1]" />
            <span class="mt-1 block text-xs font-normal text-black/50">Example: GTM-ABC1234</span>
          </label>

          <label class="block text-sm font-medium">
            Google Analytics 4 measurement ID
            <input name="ga_measurement_id" type="text" maxlength="32" pattern="G-[A-Za-z0-9]+" placeholder="G-ABC1234567" value="<%= settings.ga_measurement_id || '' %>" class="mt-2 w-full rounded-lg border border-black/15 bg-[#f5f7fc] px-4 py-3 font-mono text-sm outline-none focus:border-[#4f6fd1]" />
            <span class="mt-1 block text-xs font-normal text-black/50">Example: G-ABC1234567. Avoid configuring the same GA4 property in GTM and here to prevent duplicate events.</span>
          </label>

          <label class="block text-sm font-medium">
            Microsoft Clarity project ID
            <input name="clarity_project_id" type="text" maxlength="64" pattern="[A-Za-z0-9-]+" placeholder="Your Clarity project ID" value="<%= settings.clarity_project_id || '' %>" class="mt-2 w-full rounded-lg border border-black/15 bg-[#f5f7fc] px-4 py-3 font-mono text-sm outline-none focus:border-[#4f6fd1]" />
          </label>

          <label class="block text-sm font-medium">
            Google Search Console verification token
            <input name="search_console_token" type="text" maxlength="255" pattern="[A-Za-z0-9_-]+" placeholder="Paste the token value only" value="<%= settings.search_console_token || '' %>" class="mt-2 w-full rounded-lg border border-black/15 bg-[#f5f7fc] px-4 py-3 font-mono text-sm outline-none focus:border-[#4f6fd1]" />
            <span class="mt-1 block text-xs font-normal text-black/50">HTML-tag method only. For DNS verification, add the TXT record with your domain provider instead.</span>
          </label>
        </div>
      </section>

      <section class="rounded-2xl border border-black/5 bg-white p-5 md:p-7 shadow-sm">
        <h2 class="font-display text-lg font-semibold text-[#182253]">Lead source</h2>
        <label class="mt-4 block text-sm font-medium">
          Default source label
          <input name="default_lead_source" type="text" maxlength="100" required placeholder="Bengaluru - Varthur" value="<%= settings.default_lead_source || 'Bengaluru - Varthur' %>" class="mt-2 w-full rounded-lg border border-black/15 bg-[#f5f7fc] px-4 py-3 text-sm outline-none focus:border-[#4f6fd1]" />
          <span class="mt-1 block text-xs font-normal text-black/50">Used when the visitor URL does not include a UTM source. UTM source values take precedence.</span>
        </label>
      </section>

      <div class="flex flex-wrap items-center gap-3">
        <button type="submit" class="rounded-lg bg-[#182253] px-5 py-3 text-sm font-semibold text-white hover:bg-[#0d1230]">Save marketing settings</button>
        <a href="/admin/dashboard" class="rounded-lg border border-black/10 bg-white px-5 py-3 text-sm font-semibold text-[#182253] hover:bg-[#f5f7fc]">Back to leads and downloads</a>
        <span class="text-xs text-black/50">Lead Excel and PDF downloads are available on the dashboard.</span>
      </div>
    </form>
  </main>
</body>
</html>
